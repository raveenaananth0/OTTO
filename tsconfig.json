{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "main.tsx",
    "mock.ts",
    "kit.tsx",
    "floot.d.ts",
    "worker/*.ts"
  ]
}
